/dts-v1/;
#include <microchip/pic32c/pic32cx_bz/bz2x/bz25/pic32cx1012bz25048.dtsi>
#include "wbz451_curiosity-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	model = "Microchip WBZ451 Curiosity";
	compatible = "microchip,wbz451-curiosity";

	chosen {
		zephyr,console = &sercom0;
		zephyr,shell-uart = &sercom0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
		zephyr,bt-hci = &bt_hci_microchip;
		zephyr,bt-c2h-uart = &sercom0;
		zephyr,ieee802154 = &ieee802154;
		zephyr,cortex-m-idle-timer = &rtc;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&portb 0 GPIO_ACTIVE_HIGH>;
			label = "Red LED 1";
		};
		led1: led_1 {
			gpios = <&portb 3 GPIO_ACTIVE_HIGH>;
			label = "Green LED 1";
		};
		led2: led_2 {
			gpios = <&portb 5 GPIO_ACTIVE_HIGH>;
			label = "Blue LED 1";
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&portb 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
	/* These aliases are provided for compatibility with samples */
	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		sw0 = &button0;
		rtc = &rtc;
		watchdog0 = &wdog;
	};
};

&cpu0 {
	clock-frequency = <64000000>;
};


&sercom0 {
	status = "okay";
	compatible = "microchip,sercom-g1-uart";
	rxpo = <1>;
	txpo = <0>;
	current-speed = <115200>;
	pinctrl-0 = <&sercom0_uart_default>;
	pinctrl-names = "default";

	dmas = <&dmac 0 4>, <&dmac 1 5>;
	dma-names = "rx", "tx";
};

/* sercom 1 in spi mode, so disable uart mode
 *&sercom1 {
 *	status = "okay";
 *	compatible = "microchip,sercom-g1-uart";
 *	rxpo = <1>;
 *	txpo = <0>;
 *	current-speed = <115200>;
 *	pinctrl-0 = <&sercom1_uart_default>;
 *	pinctrl-names = "default";
 *
 *	dmas = <&dmac 2 6>, <&dmac 3 7>;
 *	dma-names = "rx", "tx";
 *};
 */

/* sercom 1 spi master mode */
&sercom1 {
	status = "okay";
	compatible = "microchip,sercom-g1-spi";
	dipo = <3>;
	dopo = <0>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom1_spi_default>;
	pinctrl-names = "default";

	dmas = <&dmac 2 6>, <&dmac 3 7>;
	dma-names = "rx", "tx";
};

/* sercom 1 spi slave mode
 *&sercom1 {
 *	status = "okay";
 *	compatible = "microchip,sercom-g1-spi";
 *	dipo = <0>;
 *	dopo = <2>;
 *	#address-cells = <1>;
 *	#size-cells = <0>;
 *	pinctrl-0 = <&sercom1_spi_default>;
 *	pinctrl-names = "default";
 *
 *	dmas = <&dmac 2 6>, <&dmac 3 7>;
 *	dma-names = "rx", "tx";
 *};
 */

&sercom2 {
	status = "okay";
	compatible = "microchip,sercom-g1-i2c";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&sercom2_i2c_default>;
	pinctrl-names = "default";

	dmas = <&dmac 4 8>, <&dmac 5 9>;
	dma-names = "rx", "tx";
};


&bt_hci_microchip {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&trng {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		code_partition: partition@0 {
			label = "code";
			reg = <0x0 DT_SIZE_K(1024-16)>;  /* Start at 0x01000000, size 1 MB */
			read-only;
		};

		/*
		 * The final 16 KiB is reserved for the application.
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@FC000 {
			label = "storage";
			reg = <0xFC000 0x00004000>;
		};
	};
};

&porta {
	status = "okay";
};

&portb {
	status = "okay";
};

/*
 *&rtc {
 *	compatible = "microchip,rtc-g1";
 *	status = "okay";
 *	prescaler = <1024>;
 *	alarms-count = <2>;
 *	cal-constant = <1048576>;  (8192 * 128 = 1048576)
 *};
 */

&rtc {
	compatible = "microchip,rtc-g1-counter";
	status = "okay";
	max-bit-width = <32>;
	prescaler = <1>;
};

&tcc0 {
	status = "disabled";
	compatible = "microchip,tcc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tcc0_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <24>;
	prescaler = <1>;
	channels = <6>;
};

&tcc1 {
	status = "disabled";
	compatible = "microchip,tcc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tcc1_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <24>;
	prescaler = <1>;
	channels = <6>;
};

&tcc2 {
	status = "disabled";
	compatible = "microchip,tcc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tcc2_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <16>;
	prescaler = <256>;
	channels = <2>;
};

/* TCC: In 16-bit/32-bit mode, the pulse value is written to CC[1]. This is because they are in MPWM
 *		mode. In MPWM mode, the wave output will can be observed in WO[1]
 */
&tc0 {
	status = "disabled";
	compatible = "microchip,tc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tc0_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <16>;
	prescaler = <256>;
	channels = <2>;
};

&tc1 {
	status = "disabled";
	compatible = "microchip,tc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tc1_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <16>;
	prescaler = <256>;
	channels = <2>;
};

&tc2 {
	status = "disabled";
	compatible = "microchip,tc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tc2_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <16>;
	prescaler = <256>;
	channels = <2>;
};

&tc3 {
	status = "disabled";
	compatible = "microchip,tc-g1-pwm";
	#pwm-cells = <3>;
	pinctrl-0 = <&tc3_pwm_default>;
	pinctrl-names = "default";
	max-bit-width = <16>;
	prescaler = <256>;
	channels = <2>;
};

&ac {
	status = "disabled";
	compatible = "microchip,ac-g1-comparator";
	comparator-channel = <0>;
	/*
	 * AC_AIN3 = RB1 (AN)
	 */
	positive-mux-input = "pin3";
	negative-mux-input = "bandgap";
	vddana-scale-value = <1>;
	output-mode = "async";
	filter-length = "off";
	run-standby;
};

&porta {
	/* GPIO_CNPUSET = 0x1FF5; Except PA1 (QSPI Data), PA3, the others are pulled up
	 * GPIO_CNPDSET = 0x0008; PA3 is Pulled down: SERCOM 0-RTS
	 */
	sleep {
		status = "disabled";
		gpio-hog;
		gpios = <0 GPIO_PULL_UP>,
			<2 GPIO_PULL_UP>,
			<4 GPIO_PULL_UP>,
			<5 GPIO_PULL_UP>,
			<6 GPIO_PULL_UP>,
			<7 GPIO_PULL_UP>,
			<8 GPIO_PULL_UP>,
			<9 GPIO_PULL_UP>,
			<10 GPIO_PULL_UP>,
			<11 GPIO_PULL_UP>,
			<12 GPIO_PULL_UP>,
			<3 GPIO_PULL_DOWN>;
		input;
	};
};

&portb {
	/* GPIO_CNPUSET = 0xF886; PB1, PB2, PB7(User LED), PB11(QSPI_SCK),
	 *                        PB12 (QSPI DATA1), PB13(QSPI DATA0) are pulled high
	 * GPIO_CNPDSET = 0x0029; pull down PB0, PB3, PB5 (LEDs)
	 */
	sleep {
		status = "disabled";
		gpio-hog;
		gpios = <1 GPIO_PULL_UP>,
			<2 GPIO_PULL_UP>,
			<7 GPIO_PULL_UP>,
			<11 GPIO_PULL_UP>,
			<12 GPIO_PULL_UP>,
			<13 GPIO_PULL_UP>,
			<14 GPIO_PULL_UP>,
			<15 GPIO_PULL_UP>,
			<0 GPIO_PULL_DOWN>,
			<3 GPIO_PULL_DOWN>,
			<5 GPIO_PULL_DOWN>;
		input;
	};
};

&wdog {
	status = "okay";
};

&qspi0 {
	status = "okay";

	mspi_flash0: mspi-flash0@0 {
		compatible = "microchip,sst26vf064b-flash","jedec,mspi-nor";

		reg = <0>;
		/* Addressing */
		address-length = "ADDR_3_BYTE";

		/* CE / command format */
		ce-break-config = <0x800000 0>;          /* 8 MB device size */
		command-length = "INSTR_1_BYTE";
		mspi-ce-polarity = "MSPI_CE_ACTIVE_LOW";
		mspi-cpp-mode = "MSPI_CPP_MODE_0";

		/* I/O mode */
		mspi-data-rate = "MSPI_DATA_RATE_SINGLE";
		mspi-io-mode   = "MSPI_IO_MODE_SINGLE";

		/* Clock */
		mspi-max-frequency = <25000000>;         /* Safe default (can increase later) */

		/* Read / Write commands */
		read-command  = <0x03>;                  /* Normal Read */
		rx-dummy = <0>;
		tx-dummy = <0>;
		write-command = <0x02>;                  /* Page Program */

	};
};
