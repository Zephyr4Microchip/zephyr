#include <dt-bindings/pic32c/pic32cx_bz/bz3/pic32cx5109bz31048-pinctrl.h>

&pinctrl {
	sercom0_uart_default: sercom0_uart_default {
		group1 {
			pinmux = <PIN_DIRECT_MODE>;
		};
	};

	sercom1_uart_default: sercom1_uart_default {
		group1 {
			pinmux = <PIN_DIRECT_MODE>;
		};
	};
};
